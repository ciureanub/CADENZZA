{
  "name": "cadenzza",
  "version": "0.1.0",
  "description": "Local-first knowledge base and deliverable library for release, deployment, environment and stakeholder management, with entity pseudonymisation.",
  "type": "module",
  "bin": {
    "cadenzza": "./bin/cadenzza.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cadenzza.js serve",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "release-management",
    "deployment",
    "knowledge-base",
    "devops",
    "salesforce",
    "pseudonymisation"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "fastify": "^5.12.5",
    "mongodb": "^7.7.0"
  }
}
